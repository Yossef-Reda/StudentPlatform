@model StudentPlatform.Models.Lecture

@{
    ViewData["Title"] = "إضافة محاضرة جديدة";
    ViewData["PageTitle"] = "إضافة محاضرة جديدة";
    ViewData["PageSubtitle"] = "أدخل بيانات المحاضرة وارفق ملفاً أو رابط فيديو اختيارياً.";
    ViewData["PageIcon"] = "bi-plus-circle-fill";
}

<partial name="_PageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sp-card p-4 p-md-5">
            <form asp-action="CreateLecture" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Title" class="form-label fw-bold small">عنوان المحاضرة</label>
                        <input asp-for="Title" class="form-control" placeholder="مثال: مقدمة في البرمجة" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="VideoUrl" class="form-label fw-bold small">رابط الفيديو (اختياري)</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-youtube" aria-hidden="true"></i></span>
                            <input asp-for="VideoUrl" class="form-control sp-num" placeholder="https://..." dir="ltr" />
                        </div>
                        <span asp-validation-for="VideoUrl" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold small">وصف المحاضرة</label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="نبذة مختصرة عن محتوى المحاضرة..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-bold small">ملف المحاضرة أو الواجب (PDF / ملف مضغوط)</label>
                        <div class="sp-dropzone" data-dropzone tabindex="0" role="button" aria-label="منطقة رفع ملف المحاضرة">
                            <span class="sp-drop-icon"><i class="bi bi-cloud-arrow-up-fill" aria-hidden="true"></i></span>
                            <div class="fw-bold small" data-file-name>اختر الملف أو اسحبه هنا</div>
                            <input type="file" name="lectureFile" class="visually-hidden" aria-label="ملف المحاضرة" />
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-sp-primary flex-grow-1"><i class="bi bi-check-lg ms-1"></i> حفظ ونشر المحاضرة</button>
                    <a asp-action="Dashboard" class="btn btn-ghost px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
