@model StudentPlatform.Models.Assignment

@{
    ViewData["Title"] = "تسليمات الواجب";
    ViewData["PageTitle"] = "تسليمات الواجب: " + Model.Title;
    ViewData["PageSubtitle"] = Model.Description;
    ViewData["PageIcon"] = "bi-inbox-fill";
    var graded = Model.Submissions?.Count(s => !string.IsNullOrEmpty(s.Grade)) ?? 0;
    var total = Model.Submissions?.Count ?? 0;
}

<partial name="_PageHeader" />

<div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
    <div class="d-flex gap-2 flex-wrap">
        <span class="sp-badge sp-badge-sky"><i class="bi bi-people-fill"></i> <span class="sp-num">@total</span> تسليم</span>
        <span class="sp-badge sp-badge-green"><i class="bi bi-check-circle-fill"></i> <span class="sp-num">@graded</span> تم تقييمه</span>
        <span class="sp-badge sp-badge-amber"><i class="bi bi-hourglass-split"></i> <span class="sp-num">@(total - graded)</span> بانتظار التقييم</span>
    </div>
    <div class="input-group sp-search">
        <span class="input-group-text bg-transparent"><i class="bi bi-search" aria-hidden="true"></i></span>
        <input type="search" class="form-control" placeholder="ابحث باسم الطالب..." aria-label="البحث في التسليمات" data-table-search="#subsTable" />
    </div>
</div>

<div class="sp-card sp-table-card">
    @if (Model.Submissions == null || !Model.Submissions.Any())
    {
        <div class="p-3">
            <partial name="_EmptyState" view-data='new ViewDataDictionary(ViewData) { { "EmptyTitle", "لا توجد تسليمات بعد" }, { "EmptyMessage", "لم يسلّم أي طالب حله لهذا الواجب حتى الآن." }, { "EmptyIcon", "bi-inbox" } }' />
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle" id="subsTable">
                <thead>
                    <tr>
                        <th>اسم الطالب</th>
                        <th>تاريخ التسليم</th>
                        <th>ملف الحل</th>
                        <th style="min-width:220px;">الدرجة / الملاحظات</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sub in Model.Submissions)
                    {
                        <tr>
                            <td class="fw-bold">@(sub.StudentName ?? "غير محدد")</td>
                            <td class="small sp-muted"><time datetime="@sub.SubmittedAt.ToString("yyyy-MM-ddTHH:mm:ss")">@sub.SubmittedAt.ToString("yyyy-MM-dd HH:mm")</time></td>
                            <td>
                                <a href="@sub.FilePath" target="_blank" rel="noopener" class="btn btn-sm btn-sp-outline" data-bs-toggle="tooltip" title="فتح حل الطالب">
                                    <i class="bi bi-download ms-1" aria-hidden="true"></i> تحميل الحل
                                </a>
                            </td>
                            <td>
                                <form asp-action="GradeSubmission" method="post" class="d-flex gap-2">
                                    <input type="hidden" name="submissionId" value="@sub.Id" />
                                    <input type="text" name="grade" value="@sub.Grade" class="form-control form-control-sm" placeholder="أدخل الدرجة..." aria-label="درجة الطالب @(sub.StudentName ?? "")" />
                                    <button type="submit" class="btn btn-sm btn-sp-primary flex-shrink-0" data-bs-toggle="tooltip" title="حفظ الدرجة"><i class="bi bi-check-lg" aria-hidden="true"></i><span class="visually-hidden">حفظ</span></button>
                                </form>
                            </td>
                            <td>
                                <partial name="_StatusBadge" model="@(string.IsNullOrEmpty(sub.Grade) ? "pending" : "submitted")" />
                                @if (string.IsNullOrEmpty(sub.Grade))
                                {
                                    <div class="small sp-muted mt-1">لم يتم التقييم</div>
                                }
                                else
                                {
                                    <div class="small text-success fw-bold mt-1">تم التقييم</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="mt-3">
    <a asp-action="Dashboard" class="btn btn-ghost btn-sm px-3"><i class="bi bi-arrow-right ms-1" aria-hidden="true"></i> العودة للوحة التحكم</a>
</div>
