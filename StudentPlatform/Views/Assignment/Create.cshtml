@model StudentPlatform.Models.Assignment

@{
    ViewData["Title"] = "إضافة واجب جديد";
    ViewData["PageTitle"] = "إضافة واجب للمحاضرة";
    ViewData["PageSubtitle"] = "حدد المطلوب وارفق الملف ثم اختر الموعد النهائي للتسليم.";
    ViewData["PageIcon"] = "bi-journal-plus";
}

<partial name="_PageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="sp-card p-4 p-md-5">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="LectureId" value="@ViewBag.LectureId" />

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label fw-bold small"></label>
                        <input asp-for="Title" class="form-control" placeholder="مثال: حل تمارين الفصل الأول" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-bold small"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="اشرح المطلوب من الطلاب بالتفصيل..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FilePath" class="form-label fw-bold small"></label>
                        <div class="sp-dropzone" data-dropzone tabindex="0" role="button" aria-label="منطقة رفع ملف الواجب">
                            <span class="sp-drop-icon"><i class="bi bi-file-earmark-arrow-up-fill" aria-hidden="true"></i></span>
                            <div class="fw-bold small" data-file-name>اختر ملف الواجب أو اسحبه هنا</div>
                            <input type="file" name="assignmentFile" class="visually-hidden" aria-label="ملف الواجب" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Deadline" class="form-label fw-bold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent"><i class="bi bi-calendar-event" aria-hidden="true"></i></span>
                            <input asp-for="Deadline" type="datetime-local" class="form-control sp-num" dir="ltr" />
                        </div>
                        <span asp-validation-for="Deadline" class="text-danger"></span>
                        <div class="form-text small">سيظهر عدّاد تنازلي للطلاب حتى هذا الموعد.</div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-sp-primary flex-grow-1"><i class="bi bi-check-lg ms-1"></i> حفظ ونشر الواجب</button>
                    <a asp-controller="Teacher" asp-action="Dashboard" class="btn btn-ghost px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
