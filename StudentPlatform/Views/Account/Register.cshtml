@model StudentPlatform.Models.RegisterViewModel

@{
    ViewData["Title"] = "تسجيل حساب جديد";
}

<div class="sp-auth-wrap py-3">
    <div class="sp-card sp-auth-card">
        <div class="text-center mb-4">
            <span class="sp-auth-logo mb-3"><i class="bi bi-person-plus-fill" aria-hidden="true"></i></span>
            <h1 class="h4 fw-bolder mb-1">إنشاء حساب طالب جديد</h1>
            <p class="sp-muted small mb-0">انضم للمنصة وابدأ رحلة التعلّم</p>
        </div>
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="All" class="text-danger mb-3 small"></div>

            <div class="form-floating mb-3">
                <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                <label asp-for="Email"></label>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Password" class="form-control" placeholder="كلمة المرور" autocomplete="new-password" />
                <label asp-for="Password"></label>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="ConfirmPassword" class="form-control" placeholder="تأكيد كلمة المرور" autocomplete="new-password" />
                <label asp-for="ConfirmPassword"></label>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-sp-primary w-100 py-2"><i class="bi bi-person-check-fill ms-1"></i> تسجيل</button>
            <p class="text-center small sp-muted mt-3 mb-0">لديك حساب؟ <a asp-action="Login" class="fw-bold text-decoration-none">تسجيل الدخول</a></p>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
